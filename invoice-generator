from datetime import date
from decimal import Decimal, ROUND_HALF_UP

TWO_PLACES = Decimal("0.01")


def money(value) -> Decimal:
    """Round a value to two decimal places, as used for rupee amounts."""
    return Decimal(str(value)).quantize(TWO_PLACES, rounding=ROUND_HALF_UP)


@dataclass
class LineItem:
    description: str
    quantity: Decimal
    unit_price: Decimal
    gst_rate: Decimal  # percent, for example 18 for 18%

    @property
    def amount(self) -> Decimal:
        return money(self.quantity * self.unit_price)

    @property
    def gst(self) -> Decimal:
        return money(self.amount * self.gst_rate / 100)


@dataclass
class Invoice:
    invoice_number: str
    seller_name: str
    seller_gstin: str
    buyer_name: str
    buyer_phone: str
    items: list = field(default_factory=list)
    invoice_date: date = field(default_factory=date.today)

    def subtotal(self) -> Decimal:
        return sum((item.amount for item in self.items), Decimal("0.00"))

    def total_gst(self) -> Decimal:
        return sum((item.gst for item in self.items), Decimal("0.00"))

    def cgst(self) -> Decimal:
        # Within the same state, GST is split equally into CGST and SGST.
        return money(self.total_gst() / 2)

    def sgst(self) -> Decimal:
        return self.total_gst() - self.cgst()

    def grand_total(self) -> Decimal:
        return self.subtotal() + self.total_gst()

    def render(self) -> str:
        lines = [
            "=" * 60,
            "TAX INVOICE".center(60),
            "=" * 60,
            f"Invoice No : {self.invoice_number}",
            f"Date       : {self.invoice_date.isoformat()}",
            "",
            f"From       : {self.seller_name}",
            f"GSTIN      : {self.seller_gstin}",
            "",
            f"Bill to    : {self.buyer_name}",
            f"Phone      : {self.buyer_phone}",
            "",
            f"{'Item':<24}{'Qty':>6}{'Rate':>10}{'GST%':>7}{'Amount':>13}",
            "-" * 60,
        ]
        for item in self.items:
            lines.append(
                f"{item.description[:24]:<24}"
                f"{item.quantity:>6}"
                f"{money(item.unit_price):>10}"
                f"{item.gst_rate:>6}%"
                f"{item.amount:>13}"
            )
        lines += [
            "-" * 60,
            f"{'Subtotal':>47}{self.subtotal():>13}",
            f"{'CGST':>47}{self.cgst():>13}",
            f"{'SGST':>47}{self.sgst():>13}",
            f"{'Grand total (INR)':>47}{self.grand_total():>13}",
            "=" * 60,
        ]
        return "\n".join(lines)


def save_invoice(invoice: Invoice, folder: str = ".") -> str:
    """Write the invoice to a text file and return the file path."""
    from pathlib import Path

    path = Path(folder) / f"invoice_{invoice.invoice_number}.txt"
    path.write_text(invoice.render(), encoding="utf-8")
    return str(path)


