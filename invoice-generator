from decimal import Decimal

from invoice import Invoice, LineItem


class InvoiceTests(unittest.TestCase):
    def make_invoice(self):
        return Invoice(
            invoice_number="T-1",
            seller_name="Seller",
            seller_gstin="TEST",
            buyer_name="Buyer",
            buyer_phone="0000",
            items=[LineItem("Service", Decimal("1"), Decimal("1000"), Decimal("18"))],
        )

    def test_totals(self):
        invoice = self.make_invoice()
        self.assertEqual(invoice.subtotal(), Decimal("1000.00"))
        self.assertEqual(invoice.total_gst(), Decimal("180.00"))
        self.assertEqual(invoice.grand_total(), Decimal("1180.00"))

    def test_cgst_and_sgst_split_evenly(self):
        invoice = self.make_invoice()
        self.assertEqual(invoice.cgst(), Decimal("90.00"))
        self.assertEqual(invoice.sgst(), Decimal("90.00"))


if __name__ == "__main__":
    unittest.main()